<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RetailSellerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/indigo_light</item>
        <item name="colorOnPrimaryContainer">@color/indigo_dark</item>

        <item name="colorSecondary">@color/emerald_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/emerald_light</item>
        <item name="colorOnSecondaryContainer">@color/emerald_dark</item>

        <item name="android:windowBackground">@color/bg_soft_gray</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
    </style>

    <style name="Theme.RetailSellerApp" parent="Base.Theme.RetailSellerApp" />

    <!-- Rounded Material Card View -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <!-- Stat Card Style -->
    <style name="Widget.App.StatCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>