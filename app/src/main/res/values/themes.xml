<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RetailSellerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/royal_light</item>
        <item name="colorOnPrimaryContainer">@color/navy_primary</item>

        <item name="colorSecondary">@color/royal_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/royal_50</item>
        <item name="colorOnSecondaryContainer">@color/royal_secondary</item>

        <item name="android:windowBackground">@color/bg_soft_gray</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/navy_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
    </style>

    <style name="Theme.RetailSellerApp" parent="Base.Theme.RetailSellerApp" />

    <!-- Elevated Enterprise Card -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <!-- KPI Stat Card -->
    <style name="Widget.App.StatCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>
</resources>